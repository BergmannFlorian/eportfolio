# MariaDB connection used by the site and the API (src/lib/server/db).
# Copy this file to `.env` and fill in the values:
#   - locally: .env at the project root (git-ignored)
#   - production: .env in REMOTE_PATH on the Infomaniak server, loaded by
#     deploy/launcher.js (it survives deployments)

# Values below target the local Docker database (`npm run db:up`, see
# compose.yaml). In production, use the Infomaniak credentials instead.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=test
DB_NAME=eportfolio
# Maximum simultaneous connections of the pool
DB_CONNECTION_LIMIT=5

# Second account for the administration (login, sessions, editing), with
# SELECT/INSERT/UPDATE/DELETE. DB_USER above can then be read-only.
# Unset locally: the administration falls back to DB_USER.
# DB_WRITE_USER=
# DB_WRITE_PASSWORD=

# Uploaded images (portrait, project images, logos), served at /media/<file>.
# Default: ./uploads (git-ignored). In production deploy/launcher.js uses
# REMOTE_PATH/uploads, outside app/, so deployments keep the files.
# UPLOADS_DIR=uploads

# Production only (adapter-node): public URL of the site and listening port
# ORIGIN=https://bergmann-florian.ch
# PORT=3000
