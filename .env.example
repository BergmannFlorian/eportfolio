# MariaDB connection used by the site and the API (src/lib/server/db).
# Copy this file to `.env` and fill in the values:
#   - locally: .env at the project root (git-ignored)
#   - production: .env in REMOTE_PATH on the Infomaniak server, loaded by
#     deploy/launcher.js (it survives deployments)

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Maximum simultaneous connections of the pool
DB_CONNECTION_LIMIT=5

# Production only (adapter-node): public URL of the site and listening port
# ORIGIN=https://bergmann-florian.ch
# PORT=3000
