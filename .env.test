# Test database used by `npm test` (overrides .env in test mode).
# The test setup DROPS and recreates every table: DB_NAME must end with "_test".
# Override locally in .env.test.local (git-ignored) if your credentials differ.
# In CI the same values come from the MariaDB service of the deploy workflow.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=test
DB_NAME=eportfolio_test
